# Copy this file to .env and adjust if needed. Never commit .env.

# --- Local web app (keep it on loopback; do not expose to the internet) ---
APP_HOST=127.0.0.1
APP_PORT=8765
LOG_LEVEL=INFO

# --- Ollama ---
# Option A (default): the daemon on this laptop.
OLLAMA_HOST=http://localhost:11434
# Option B: a friend's machine on the same Tailscale network. Set both lines:
#   OLLAMA_HOST=http://100.101.102.103:11434
#   OLLAMA_ALLOW_REMOTE=true
# Without the flag a non-loopback host is refused at startup. With it, only
# Tailscale addresses are accepted (100.64.0.0/10, fd7a:115c:a1e0::/48, *.ts.net).
OLLAMA_ALLOW_REMOTE=false
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=16384
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_S=600
OLLAMA_KEEP_ALIVE=30m
# Thinking mode improves reasoning but roughly doubles latency on CPU.
OLLAMA_THINK=false

# --- Browser ---
# Chrome is already installed on this machine, so we use channel=chrome.
BROWSER_CHANNEL=chrome
# The browser MUST stay visible for manual Moodle login and user oversight.
BROWSER_HEADLESS=false
BROWSER_TIMEOUT_MS=30000
BROWSER_PROFILE_DIR=browser/profile

# --- Moodle ---
# Your Moodle site, e.g. https://moodle.example.edu/
# Set it here, or leave it blank and set it in the dashboard at runtime.
MOODLE_URL=
# Courses to hide everywhere (dashboard, sync, folders), as comma-separated
# course page URLs, e.g. https://moodle.example.edu/course/view.php?id=123
IGNORED_COURSES=

# --- Safety limits ---
MAX_DOWNLOAD_MB=50
# Chat image attachments: per-image cap (after browser downscaling) and count.
MAX_IMAGE_MB=8
MAX_IMAGES_PER_MESSAGE=4
MAX_PAGE_CHARS=14000
MAX_TOOL_RESULT_CHARS=8000
APPROVAL_TIMEOUT_S=300
MAX_AGENT_ITERATIONS=12
